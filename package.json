{
  "name": "sxm-rentals-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify API + business logic for SXM Rentals",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/scripts/create-admin.ts",
    "tasks:daily": "tsx --env-file-if-exists=.env src/scripts/daily-tasks.ts"
  },
  "author": "Giordano Bertin-Maurice",
  "license": "UNLICENSED",
  "copyright": "Copyright (c) 2026 Giordano Bertin-Maurice. All rights reserved.",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
