# SXM Rentals — Created by Giordano Bertin-Maurice
# Copyright (c) 2026 Giordano Bertin-Maurice. All rights reserved.
# WHAT THIS FILE DOES: A template of every setting the backend reads. Copy it
# to a file named .env and fill in real values there — never here. This file
# is saved in git, so it must never contain a real password or key.

# development | test | production
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# The Neon Postgres connection string for YOUR branch. Leave empty in
# development to use a small database kept on this computer in .data/.
DATABASE_URL=

# The websites allowed to call this API from a browser, comma separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# Where the customer website lives; used to build links inside emails.
APP_URL=http://localhost:3000

# Set to false to skip the check against known-leaked passwords (e.g. offline).
BREACHED_PASSWORD_CHECK=true

# The key that encrypts the most sensitive stored values (staff two-factor
# secrets). Required in production; without it, staff sign-in refuses to work
# rather than storing a secret in plain text.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Addresses allowed to reach the admin API (office, VPN), comma separated.
# Empty means no address restriction — two-factor codes still apply.
ADMIN_IP_ALLOWLIST=

# The logo drawn at the top of every email. It MUST be reachable without
# signing in, or mail programs show the words "SXM Rentals" instead of the
# image. Leave empty to use the website's own copy at APP_URL/brand/logo-white.png
# — which only works once the website is public.
EMAIL_LOGO_URL=

# Resend, which actually delivers the emails. Leave empty on your own computer:
# every email is then printed into the terminal so you can click the link in it.
# In production, an empty key means emails are NOT sent and a loud warning is
# written to the logs instead.
RESEND_API_KEY=
# Who emails appear to come from. Until a domain is verified in Resend, leave
# this as it is: Resend's shared test address, which can only deliver to the
# email you signed up with. Once sxmrentals.app is verified, change it to
# something like: SXM Rentals <bookings@sxmrentals.app>
EMAIL_FROM=SXM Rentals <onboarding@resend.dev>
# Where replies go, if that should differ from the address above.
EMAIL_REPLY_TO=

# The social accounts shown at the bottom of every email. Leave one empty until
# that account actually exists: its name is then written as plain words instead
# of a link that goes nowhere. A social icon that does nothing when clicked
# reads as a broken website rather than an unopened account.
SOCIAL_TIKTOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_FACEBOOK_URL=

# Cloudinary, where car photos are kept. All three or none: with a half-set
# account the server cannot sign an upload, so it would fail at the worst
# moment instead of the first one. Leave empty and the photo endpoints answer
# "not switched on yet" rather than accepting a photo that goes nowhere.
# From the Cloudinary dashboard: Settings -> API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe. Leave empty until the account is connected: the payment and deposit
# endpoints then answer "not switched on yet" instead of pretending to charge.
# Use the TEST keys (sk_test_...) everywhere except production.
STRIPE_SECRET_KEY=
# From the Stripe dashboard's webhook settings. Without it, incoming Stripe
# messages are refused, because an unsigned one could be sent by anybody.
STRIPE_WEBHOOK_SECRET=
# The currency bookings are charged in.
CURRENCY=usd

# How many proxies sit in front of the server (Render = 1). Used to see each
# visitor's real address for rate limiting. 0 on your own computer.
TRUST_PROXY_HOPS=0

# debug | info | warn | error
LOG_LEVEL=info

# Which features the phone app may show — comma separated names, or "all". A
# feature also has to be built and set up (Stripe keys for payments, and so on)
# before it counts as on. Empty: the app says "not connected yet" for all of
# them. See GET /api/v1/capabilities for the names.
FEATURES=
# Names taken back out of "all", to switch one off in a hurry.
FEATURES_OFF=
